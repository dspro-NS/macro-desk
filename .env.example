# SQLite file path (created automatically)
MACRO_DESK_DATABASE_PATH=data/macro_desk.sqlite

# Official RBI RSS feeds (one GET each per ingest)
MACRO_DESK_RBI_RSS_URL=https://rbi.org.in/pressreleases_rss.xml
MACRO_DESK_RBI_NOTIFICATION_RSS_URL=https://rbi.org.in/notifications_rss.xml
MACRO_DESK_RBI_SPEECHES_RSS_URL=https://rbi.org.in/speeches_rss.xml

# Conservative HTTP behaviour
MACRO_DESK_HTTP_TIMEOUT_SECONDS=20
MACRO_DESK_USER_AGENT=MacroDesk/0.1 (+https://github.com/dspro-NS/macro-desk; personal research ingestion)
